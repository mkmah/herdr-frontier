{
  "name": "herdr-frontier",
  "version": "0.3.1",
  "module": "src/index.tsx",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run --preload @opentui/solid/preload --watch src/index.tsx",
    "build": "bun run scripts/build.ts",
    "policy:check": "bun run scripts/policy-check.ts",
    "changeset": "changeset",
    "version": "changeset version && bun scripts/sync-version.ts",
    "release": "bun scripts/release.ts"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.0",
    "@types/bun": "latest",
    "@types/node": "^26.2.0"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-typescript": "^8.0.1",
    "@opentui/core": "^0.5.1",
    "@opentui/solid": "^0.5.1",
    "babel-preset-solid": "1.9.12",
    "solid-js": "1.9.14"
  }
}
