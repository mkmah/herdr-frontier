{
  "compilerOptions": {
    // Environment setup & latest features
    "types": ["bun", "node"],
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "preserve",
    "jsxImportSource": "@opentui/solid",
    "allowJs": true,

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Path alias — `#/` → `src/` (imports under the project root use the alias
    // instead of relative hops; bun + tsc both honor this from tsconfig).
    // No `baseUrl`: since TS 4.1 `paths` entries resolve relative to this file
    // (and `baseUrl` is deprecated in TS 6/7).
    "paths": {
      "#/*": ["./src/*"]
    },

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false
  }
}
